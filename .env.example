APP_NAME=Daway
APP_ENV=local

# Phase F1 — تزويد الأدمن الأولي: كلمة المرور من البيئة فقط (لا قيمة افتراضية في الكود).
# غياب ADMIN_INITIAL_PASSWORD = AdminSeeder لا ينشئ أدمن ويُسجّل تحذيرًا.
ADMIN_EMAIL=admin@daway.com
ADMIN_INITIAL_PASSWORD=
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=daway_db
DB_USERNAME=root
DB_PASSWORD=

# تعطيل التحقق من شهادة SSL عند مزامنة بيانات وزارة الصحة (يقرأها أمر moh:sync)
MOH_SSL_VERIFY=false
# عناوين API لوزارة الصحة — القيم الافتراضية في config/services.php (تجاوز اختياري، فعّلهما عند الحاجة)
# MOH_PRODUCTS_URL=https://pharmacy.moh.ps/service/getRegisterProducts
# MOH_PRICES_URL=https://pharmacy.moh.ps/service/getDrugsPublic

# Phase 2: was database -> every web request read+wrote the sessions table
# over the public network to Aiven. file writes inside storage/framework/sessions.
# Production pins this too (render.yaml SESSION_DRIVER=file).
SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure cookies only over HTTPS; set to true in production (render.yaml)
SESSION_SECURE_COOKIE=false

# Sanctum API token expiry in minutes (10080 = 7 days)
SANCTUM_EXPIRATION=10080
# Sanctum: domains allowed to send stateful (session) cookies to /api/*
# comma-separated hosts without scheme, e.g. daway-backend-zlh2.onrender.com
SANCTUM_STATEFUL_DOMAINS=

# Firebase Web Push (FCM) — client config is public; server account file is a secret
# FIREBASE_CREDENTIALS=/etc/secrets/firebase-service-account.json (Render Secret File — never commit)
FIREBASE_CREDENTIALS=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# Comma-separated list of trusted proxies (empty = none, e.g. "10.0.0.1,10.0.0.2")
# C-1: على Render اتركها فارغة — نطاقات موازن التحميل غير معلنة وغير مستقرة،
# واستخدام "*" يثق بأي وكيل (انتحال IP عبر رأس X-Forwarded-For).
# النتيجة: IP العميل يُحتسب من REMOTE_ADDR (IP الـ LB) — عالجها بتحديد معدل لكل حساب.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# ============================================================================
# إشعارات التحويل المالي (Settlement transfer receipts)
# ============================================================================
# ⚠️ الوضع المعتمد حاليًا: cloudinary_public — رفع **غير موقّع** عبر
#    CLOUDINARY_UPLOAD_PRESET (نفس preset صور الأدوية)، بلا أي مفاتيح.
#    الملف الناتج **عام**: أي شخص يملك رابطه يستطيع فتحه. إخفاء الرابط في
#    استجابات الـAPI لا يجعله خاصًا.
#
#  · cloudinary_public = الوضع المعتمد (صور JPG/PNG/WEBP فقط — PDF موقوف)
#  · cloudinary        = الوضع المحمي القديم (signed + authenticated) — يحتاج
#                        CLOUDINARY_API_KEY و CLOUDINARY_API_SECRET
#  · disk              = القرص المضبوط في SETTLEMENT_RECEIPT_DISK أدناه
#  · auto              = cloudinary_public إن كان الـpreset مضبوطًا، وإلا القرص
SETTLEMENT_RECEIPT_DRIVER=cloudinary_public

# مجلد الإيصالات داخل Cloudinary (منفصل عن مجلد صور الأدوية).
CLOUDINARY_RECEIPTS_FOLDER=daway/settlement-receipts

# --- الوضع المحمي القديم فقط (غير مستخدم في cloudinary_public) ---
# لا تضع قيمًا هنا إلا إذا قررت العودة إلى الرفع الموقّع.
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
CLOUDINARY_RECEIPTS_TYPE=authenticated
CLOUDINARY_RECEIPTS_PDF_RESOURCE=raw

# --- احتياطي: قرص Laravel (يُستخدم فقط عندما SETTLEMENT_RECEIPT_DRIVER=disk) ---
#  · local = تخزين داخل الحاوية — مؤقت على Render، تُفقد الملفات عند كل نشر.
#  · r2    = Cloudflare R2 (تخزين دائم) — يتطلب المتغيرات أدناه.
# الكود يرفض أي قرص غير مهيّأ أو مضبوط على visibility=public (يرجع 500 صريح).
SETTLEMENT_RECEIPT_DISK=local

# Cloudflare R2 — مفتاح API بصلاحية Object Read & Write على الـbucket فقط.
# لا تُستخدم مفاتيح R2 العامة، ولا تُمنح صلاحية إدارة الحساب.
# endpoint = https://<ACCOUNT_ID>.r2.cloudflarestorage.com
# region   = auto (إلزامي لـ R2)
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_REGION=auto
R2_USE_PATH_STYLE_ENDPOINT=false

# PHASE 1.5 (اقتراح فقط — لا عامل حالياً): عند تشغيل عامل الطابور على Render
# (خدمة Worker منفصلة على الخطة المجانية) شغّل:
#   php artisan queue:work --tries=3 --backoff=5
# الجداول (jobs/job_batches/failed_jobs) موجودة منذ هذا الإصدار؛ الاتصال يبقى database.

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# تخزين الصور (Cloudinary): اسم السحابة + preset الرفع غير الموقّع.
# عند تركها فارغة تُخزن الصور محلياً في public/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=daway

VITE_APP_NAME="${APP_NAME}"

# مفتاح Google Maps للخرائط على الواجهة (يُقرأ من الواجهة فقط)
GOOGLE_MAPS_API_KEY=

# مساعد الذكاء الاصطناعي (تحليل رسائل الشات: نية البحث + اسم الدواء)
# عند تركه فارغاً يعمل المساعد بمستخرج محلي حتمي بلا أي استدعاء خارجي،
# ولا يكسر الرد. الـ AI مسؤول عن استخراج النية/اسم الدواء فقط —
# الأسعار والتوفر والمسافة والترتيب كلها من قاعدة البيانات.
# C-1: المهلة الافتراضية 8 ثوانٍ — لا نحتجز عمال سيرفر PHP على اتصال خارجي بطيء
DAWAY_AI_BASE_URL=
DAWAY_AI_TIMEOUT=8
DAWAY_AI_KEY=

# خدمة OCR (قراءة اسم الدواء من صورة العلبة)# عند تركها فارغة يرجع الـ endpoint خطأ واضح بدون استدعاء خارجي
# C-1: المهلة الافتراضية 8 ثوانٍ (كانت 20)
DAWAY_OCR_BASE_URL=
DAWAY_OCR_TIMEOUT=8
DAWAY_OCR_KEY=

# ============ Medicine Data Enrichment (FREE only) ============
# Cost Guard: ������� ������ ���. �� ����� ����� �������� ���� ���
# ������ ���� ��� (false = fail closed� ��������� �� ��� ����� ����).
ENRICHMENT_PAID_PROVIDERS=false

# ������� �������� (banners ����� ��� ��� ������� NLM/FDA/Wikidata)
ENRICHMENT_LOCAL_ENABLED=true
ENRICHMENT_PALESTINIAN_ENABLED=false
ENRICHMENT_RXNORM_ENABLED=true
ENRICHMENT_OPENFDA_ENABLED=true
OPENFDA_API_KEY=
ENRICHMENT_DAILYMED_ENABLED=true
ENRICHMENT_WIKIDATA_ENABLED=true

# ����� ����� - ����� ������ POST cost guard
ENRICHMENT_MANUAL_ENABLED=true
DRUGS_API_ENABLED=false
DRUGS_API_BASE_URL=
DRUGS_API_KEY=
DRUGS_API_SEARCH_PATH=
DRUGS_API_BARCODE_PATH=

# === Pharmacy Accounting UI ===
# Set to true to show the Accounting section (Sales, Refunds, Cash) in the
# pharmacy sidebar. Set to false (or leave empty) to hide it.
# Production pins this in render.yaml: PHARMACY_ACCOUNTING_UI=true
PHARMACY_ACCOUNTING_UI=false

# ============ SMSGate (SMS Provider) ============
# SMSGate API credentials � ������� ������ OTP �������� ��� SMS.
# ��� ����� ����� ������� ������� (no-op).
# �������: POST /3rdparty/v1/messages �� Basic Auth
SMSGATE_BASE_URL=
SMSGATE_USERNAME=
SMSGATE_PASSWORD=
SMSGATE_SENDER=Daway
SMSGATE_COUNTRY_CODE=+970

# ============ Android SMS Gateway (Local) ============
# ����� ���� Android + SIM ��� SMS Gateway ��� HTTP API.
# ������� ����� �� SMSGate Cloud � ���� OTP ������ ��� SIM.
# ��������: Android ��� enabled ? SMSGate ��� enabled ? no-op
# �������: https://github.com/capcom6/android-sms-gateway
# ����: ANDROID_SMS_GATEWAY_BASE_URL=http://192.168.1.50:8080
ANDROID_SMS_GATEWAY_ENABLED=false
ANDROID_SMS_GATEWAY_BASE_URL=
ANDROID_SMS_GATEWAY_USERNAME=
ANDROID_SMS_GATEWAY_PASSWORD=
ANDROID_SMS_GATEWAY_TIMEOUT=10
ANDROID_SMS_GATEWAY_COUNTRY_CODE=+970

ANDROID_SMS_GATEWAY_DEVICE_ID=

# --- CORS -------------------------------------------------------------------
# Comma-separated list of EXACT allowed origins.
#
# A single entry here is a trap: with exactly one origin configured and no
# patterns, fruitcake/php-cors echoes that origin on EVERY response no matter
# who asked. The browser then compares it with the page's own origin, sees a
# mismatch, and blocks the response -- so login "does nothing" on any URL that
# is not that one origin (Vercel preview/branch aliases, custom domains),
# even though the API answers 200 with a valid token.
#
# Production example:
#   CORS_ALLOWED_ORIGINS=https://daway-frontend.vercel.app
#
# Extra PCRE patterns, comma-separated, added on top of the built-in
# `daway-frontend*.vercel.app` default in config/cors.php. Use this for a
# custom domain that is not on vercel.app:
#   CORS_ALLOWED_ORIGIN_PATTERNS=~^https://app\.example\.com$~
CORS_ALLOWED_ORIGINS=
CORS_ALLOWED_ORIGIN_PATTERNS=
