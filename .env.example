APP_NAME=Daway
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug
LOG_DAILY_DAYS=14

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=daway_db
DB_USERNAME=root
DB_PASSWORD=

# تعطيل التحقق من شهادة SSL عند مزامنة بيانات وزارة الصحة (يقرأها أمر moh:sync)
MOH_SSL_VERIFY=false
# عناوين API لوزارة الصحة — القيم الافتراضية في config/services.php (تجاوز اختياري، فعّلهما عند الحاجة)
# MOH_PRODUCTS_URL=https://pharmacy.moh.ps/service/getRegisterProducts
# MOH_PRICES_URL=https://pharmacy.moh.ps/service/getDrugsPublic

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# Secure cookies only over HTTPS; set to true in production (render.yaml)
SESSION_SECURE_COOKIE=false

# Sanctum API token expiry in minutes (10080 = 7 days)
SANCTUM_EXPIRATION=10080
# Sanctum: domains allowed to send stateful (session) cookies to /api/*
# comma-separated hosts without scheme, e.g. daway-backend-zlh2.onrender.com
SANCTUM_STATEFUL_DOMAINS=

# Firebase Web Push (FCM) — client config is public; server account file is a secret
# FIREBASE_CREDENTIALS=/etc/secrets/firebase-service-account.json (Render Secret File — never commit)
FIREBASE_CREDENTIALS=
FIREBASE_API_KEY=
FIREBASE_AUTH_DOMAIN=
FIREBASE_PROJECT_ID=
FIREBASE_STORAGE_BUCKET=
FIREBASE_MESSAGING_SENDER_ID=
FIREBASE_APP_ID=
FIREBASE_VAPID_KEY=

# Comma-separated list of trusted proxies (empty = none, e.g. "10.0.0.1,10.0.0.2")
# C-1: على Render اتركها فارغة — نطاقات موازن التحميل غير معلنة وغير مستقرة،
# واستخدام "*" يثق بأي وكيل (انتحال IP عبر رأس X-Forwarded-For).
# النتيجة: IP العميل يُحتسب من REMOTE_ADDR (IP الـ LB) — عالجها بتحديد معدل لكل حساب.
TRUSTED_PROXIES=

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

# PHASE 1.5 (اقتراح فقط — لا عامل حالياً): عند تشغيل عامل الطابور على Render
# (خدمة Worker منفصلة على الخطة المجانية) شغّل:
#   php artisan queue:work --tries=3 --backoff=5
# الجداول (jobs/job_batches/failed_jobs) موجودة منذ هذا الإصدار؛ الاتصال يبقى database.

CACHE_STORE=database

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

# تخزين الصور (Cloudinary): اسم السحابة + preset الرفع غير الموقّع.
# عند تركها فارغة تُخزن الصور محلياً في public/uploads
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_UPLOAD_PRESET=
CLOUDINARY_FOLDER=daway

VITE_APP_NAME="${APP_NAME}"

# مفتاح Google Maps للخرائط على الواجهة (يُقرأ من الواجهة فقط)
GOOGLE_MAPS_API_KEY=

# مساعد الذكاء الاصطناعي (تحليل رسائل الشات: نية البحث + اسم الدواء)
# عند تركه فارغاً يرجع الـ endpoint نتيجة fallback بدون AI
# C-1: المهلة الافتراضية 8 ثوانٍ (كانت 15) — لا نحتجز عمال سيرفر PHP CLI على اتصال خارجي بطيء

# خدمة OCR (قراءة اسم الدواء من صورة العلبة)
# عند تركها فارغة يرجع الـ endpoint خطأ واضح بدون استدعاء خارجي
# C-1: المهلة الافتراضية 8 ثوانٍ (كانت 20)
DAWAY_OCR_BASE_URL=
DAWAY_OCR_TIMEOUT=8
DAWAY_OCR_KEY=
