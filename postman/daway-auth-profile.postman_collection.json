                "value": "Bearer {{pharmacy_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/profile/pharmacy",
              "host": ["{{base_url}}"],
              "path": ["profile", "pharmacy"]
            }
          }
        },
        {
          "name": "9- تحديث بروفايل الصيدلية",
          "request": {
            "method": "POST",
            "header": [
              {
