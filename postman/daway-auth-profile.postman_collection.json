              "raw": "{\n  \"name\": \"صيدلية الأمل\",\n  \"phone\": \"+970591234567\",\n  \"logo_url\": \"https://res.cloudinary.com/demo/image/upload/v1/logo.png\",\n  \"latitude\": 31.5016,\n  \"longitude\": 34.4668,\n  \"address\": \"غزة - شارع الوحدة\",\n  \"working_hours\": {\n    \"sat\": { \"open\": \"09:00\", \"close\": \"22:00\" },\n    \"sun\": { \"open\": \"09:00\", \"close\": \"22:00\" },\n    \"mon\": { \"open\": \"09:00\", \"close\": \"22:00\" },\n    \"tue\": null,\n    \"wed\": null,\n    \"thu\": null,\n    \"fri\": null\n  }\n}",
