              }
            },
            "url": {
              "raw": "{{base_url}}/profile/patient",
              "host": ["{{base_url}}"],
              "path": ["profile", "patient"]
            }
          }
        }
      ]
    },
    {
      "name": "Profile - Pharmacy",
      "item": [
