{
  "info": {
    "_postman_id": "daway-auth-profile-2026-001",
    "name": "Daway API - Auth & Profile",
    "description": "تسجيل الدخول/الخروج + قراءة وتحديث البروفايل (مريض وصيدلية).\n\nالاستخدام:\n1. شغّل محلياً: php artisan serve — أو استخدم الإنتاج مباشرة (base_url الحالي)\n2. تأكد إن base_url = https://daway-backend-zlh2.onrender.com/api\n3. اعمل OTP send ثم verify (أو pharmacy login) — التوكن بينحفظ تلقائياً بالمتغيرات\n4. باقي الـ requests جاهزة بتستخدم التوكن المحفوظ",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "https://daway-backend-zlh2.onrender.com/api"
    },
    {
      "key": "patient_token",
      "value": ""
    },
    {
      "key": "pharmacy_token",
      "value": ""
    },
    {
      "key": "otp_code",
      "value": ""
    }
  ],
  "item": [
    {
      "name": "Auth",
      "item": [
        {
          "name": "1- إرسال OTP",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0599123456\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/otp/send",
              "host": ["{{base_url}}"],
              "path": ["otp", "send"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.otp) {",
                  "    pm.collectionVariables.set('otp_code', json.otp);",
                  "    console.log('OTP = ' + json.otp);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "2- تحقق OTP / تسجيل دخول المريض",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0599123456\",\n  \"otp\": \"{{otp_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/otp/verify",
              "host": ["{{base_url}}"],
              "path": ["otp", "verify"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) {",
                  "    pm.collectionVariables.set('patient_token', json.data.token);",
                  "    console.log('patient_token محفوظ');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "3- تسجيل دخول المريض (نفس الـ verify)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"phone\": \"0599123456\",\n  \"otp\": \"{{otp_code}}\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login/patient",
              "host": ["{{base_url}}"],
              "path": ["login", "patient"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) {",
                  "    pm.collectionVariables.set('patient_token', json.data.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "4- تسجيل دخول الصيدلية",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"pharmacy_id\": \"PH-1234\",\n  \"password\": \"password\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": {
              "raw": "{{base_url}}/login/pharmacy",
              "host": ["{{base_url}}"],
              "path": ["login", "pharmacy"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const json = pm.response.json();",
                  "if (json.success) {",
                  "    pm.collectionVariables.set('pharmacy_token', json.data.token);",
                  "    console.log('pharmacy_token محفوظ');",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "5- خروج (logout)",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              },
              {
                "key": "Authorization",
                "value": "Bearer {{patient_token}}"
              }
            ],
            "url": {
              "raw": "{{base_url}}/logout",
              "host": ["{{base_url}}"],
              "path": ["logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Profile - Patient",
